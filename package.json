{
  "name": "elypink-theme",
  "displayName": "Elypink Theme",
  "description": "lovely theme for VSC",
  "version": "0.4.0",
  "publisher": "barineco",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "pink",
    "light",
    "pastel"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Elypink Light",
        "uiTheme": "vs",
        "path": "./themes/elypink-light.json"
      },
      {
        "label": "Elypink Light Subtle",
        "uiTheme": "vs",
        "path": "./themes/elypink-light-subtle.json"
      },
      {
        "label": "Qinshi Light",
        "uiTheme": "vs",
        "path": "./themes/elypink-light-qinshi.json"
      },
      {
        "label": "Elypink Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/elypink-dark.json"
      },
      {
        "label": "Elypink Dark Subtle",
        "uiTheme": "vs-dark",
        "path": "./themes/elypink-dark-subtle.json"
      },
      {
        "label": "Qinshi Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/elypink-dark-qinshi.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/barineco/elypink-theme-vsc"
  },
  "icon": "images/elypink-light.png",
  "galleryBanner": {
    "color": "#DEA4BD",
    "theme": "light"
  },
  "license": "MIT",
  "scripts": {
    "generate-subtle": "node scripts/generate-subtle.js",
    "generate-qinshi": "node scripts/generate-qinshi.js",
    "generate-dark": "node scripts/generate-dark.js"
  }
}
